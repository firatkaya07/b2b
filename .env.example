# PostgreSQL bağlantısı (Supabase > Project Settings > Database > Connection string > Transaction pooler)
# Örnek: postgresql://postgres.<ref>:<sifre>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Oturum imzalama anahtarı (production'da güçlü rastgele bir değerle değiştirin)
AUTH_SECRET=degistir-bu-cok-gizli-bir-anahtar-olmali-32char+

# SMS / OTP sağlayıcısı: mock | netgsm | twilio
SMS_PROVIDER=mock
# Netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Ödeme sağlayıcısı: mock | iyzico | paytr
PAYMENT_PROVIDER=mock
# iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# PayTR
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Kargo sağlayıcısı: mock | aras | yurtici
CARGO_PROVIDER=mock
ARAS_USERNAME=
ARAS_PASSWORD=
YURTICI_USERNAME=
YURTICI_PASSWORD=

# Uygulama URL'si (ödeme callback için)
APP_URL=http://localhost:3000
